# Django
SECRET_KEY=change-me-to-a-secure-random-string
DEBUG=True
DJANGO_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_NAME=NextGen News
SITE_URL=http://localhost:8000
TIME_ZONE=Asia/Manila

# Database (PostgreSQL for production; SQLite used in development / pythonanywhere by default)
DB_ENGINE=sqlite
DB_NAME=nextgen_news
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis (not required for DJANGO_ENV=pythonanywhere)
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@nextgennews.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security (Production / PythonAnywhere)
SECURE_SSL_REDIRECT=False
SERVE_MEDIA=False

# AI Features (Architecture Ready)
AI_SUMMARY_ENABLED=False
AI_HEADLINE_ENABLED=False
AI_SEO_ENABLED=False
AI_TAGS_ENABLED=False
AI_DUPLICATE_ENABLED=False

# ---------------------------------------------------------------------------
# PythonAnywhere example (copy into .env on the server)
# ---------------------------------------------------------------------------
# DJANGO_ENV=pythonanywhere
# DEBUG=False
# SECRET_KEY=generate-a-long-random-string
# ALLOWED_HOSTS=yourusername.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
# SITE_URL=https://yourusername.pythonanywhere.com
# SECURE_SSL_REDIRECT=True
# SERVE_MEDIA=True
# DB_ENGINE=sqlite
# # Or MySQL (also run: pip install mysqlclient):
# # DB_ENGINE=mysql
# # DB_NAME=yourusername$nextgen_news
# # DB_USER=yourusername
# # DB_PASSWORD=your-mysql-password
# # DB_HOST=yourusername.mysql.pythonanywhere-services.com
